# Copy to .env (all optional). Keys for Metricool, Buffer, Instagram and the AI are NOT set here:
# each user enters theirs in the panel (Settings), and the admin sets the shared ones (Admin).

# The panel's public address, used in links (Telegram messages, MCP/ChatGPT instructions)
SAJADAI_PUBLIC_URL=

# 1 when the panel is served over HTTPS, so session cookies are only sent over HTTPS
SAJADAI_SECURE_COOKIES=0

# The key that encrypts users' stored keys. Leave empty to have one generated into the data folder
# on first start (then back that folder up). To make one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SAJADAI_SECRET_KEY=
